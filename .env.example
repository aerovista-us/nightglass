PORT=3000
HOST=0.0.0.0
DATA_DIR=/data
ENGINE_MODE=mock

SHERLOCK_BIN=sherlock
HOLEHE_BIN=holehe
SPIDERFOOT_URL=http://spiderfoot:5001

# Optional Nightglass // SIGNAL provider. Keep the service private/loopback-only.
SHADOWBROKER_URL=http://127.0.0.1:8000
SHADOWBROKER_HMAC_SECRET=
SHADOWBROKER_TIMEOUT_MS=15000

# RECORDS providers. SEC asks automated clients to identify themselves with contact info.
SEC_USER_AGENT=
RECORDS_TIMEOUT_MS=15000

# Opt-in isolated evidence capture worker. Use a long random token and do not commit a real value.
CAPTURE_WORKER_URL=http://capture-worker:8090
CAPTURE_WORKER_TOKEN=
CAPTURE_CLIENT_TIMEOUT_MS=30000
CAPTURE_TIMEOUT_MS=15000
CAPTURE_MAX_BYTES=5242880
CAPTURE_MAX_REDIRECTS=4

JOB_TIMEOUT_MS=120000
MAX_BODY_BYTES=65536
